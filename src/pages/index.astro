---
import CardGrid from "../components/card-grid.astro";
import PostCard from "../components/post-card.astro";
import BaseLayout from "../layouts/base.astro";
import { getVisiblePostsNewestFirst } from "../lib/posts";

const cardCountPerSection = 2;
const posts = (await getVisiblePostsNewestFirst()).slice(
	0,
	cardCountPerSection,
);
---

<BaseLayout title="mizznoff.com">
	<section>
		<h2 class="text-3xl font-bold text-center pb-6">Blog</h2>
		<CardGrid>
			{posts.map((post) => (
				<PostCard post={post} />
			))}
		</CardGrid>
		<p class="text-center text-sm pt-4">
			<a href="/posts/">もっと見る →</a>
		</p>
	</section>
</BaseLayout>
