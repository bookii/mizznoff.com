---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
	href: string;
	title: string;
	thumbnail?: ImageMetadata;
}

const { href, title, thumbnail } = Astro.props;
---

<li class="card aspect-8/9 overflow-hidden bg-base-100 shadow">
	<a href={href} class="flex h-full flex-col">
		<figure class="aspect-video shrink-0 bg-base-300">
			{thumbnail && (
				<Image src={thumbnail} alt="" class="size-full object-cover" />
			)}
		</figure>
		<div class="card-body min-h-0">
			<h3 class="card-title line-clamp-2 min-h-[2lh] shrink-0">{title}</h3>
			<slot />
		</div>
	</a>
</li>
