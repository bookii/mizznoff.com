---
import "@fontsource-variable/m-plus-2/index.css";
import "../assets/app.css";
import ProfileMenu from "../components/profile-menu.astro";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ja" class="bg-base-200">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="flex items-center justify-between">
			<a href="/" class="text-xl font-bold">
				mizznoff.com
			</a>
			<ProfileMenu />
		</header>
		<main>
			<slot />
		</main>
		<footer>
			<p class="text-sm text-center text-base-content/70">
				© {new Date().getFullYear()} mizznoff
			</p>
		</footer>
	</body>
</html>

<style>
	body {
		font-family: "M PLUS 2 Variable", sans-serif;
		display: flex;
		flex-direction: column;
		min-height: 100svh;
	}

	header,
	main,
	footer {
		margin: 1rem auto;
		width: 100%;
		max-width: 60rem;
		padding: 0 1rem;
	}

	main {
		flex-grow: 1;
	}
</style>
